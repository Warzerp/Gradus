# Copia este archivo a .env y ajusta los valores antes de iniciar con Docker
DB_USER=postgres
DB_PASS=cambiar_en_produccion

# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_UN_SECRET_SEGURO_DE_AL_MENOS_64_CHARS

# API Key de OpenAI para generación de embeddings
OPENAI_API_KEY=sk-...

# Clave AES-256 en Base64 (32 bytes): openssl rand -base64 32
AES_KEY_BASE64=

# Orígenes permitidos para CORS en producción
CORS_ORIGINS=http://localhost
