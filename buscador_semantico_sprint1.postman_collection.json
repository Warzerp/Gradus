{
  "info": {
    "name": "Buscador Semántico — Sprint 1 Auth",
    "_postman_id": "bs-sprint1-auth",
    "description": "Endpoints de autenticación del Sprint 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080" },
    { "key": "access_token",  "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "POST /auth/register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan@universidad.edu.co\",\n  \"password\": \"password123\",\n  \"rol\": \"ESTUDIANTE\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('access_token', json.access_token);",
            "pm.collectionVariables.set('refresh_token', json.refresh_token);"
          ]
        }
      }]
    },
    {
      "name": "POST /auth/login — credenciales válidas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@universidad.edu.co\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Contiene access_token', () => pm.expect(pm.response.json()).to.have.property('access_token'));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('access_token', json.access_token);",
            "pm.collectionVariables.set('refresh_token', json.refresh_token);"
          ]
        }
      }]
    },
    {
      "name": "POST /auth/login — credenciales INVÁLIDAS (debe retornar 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@universidad.edu.co\",\n  \"password\": \"wrongpassword\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 401 (no 500)', () => pm.response.to.have.status(401));"
          ]
        }
      }]
    },
    {
      "name": "POST /auth/refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Nuevo access_token', () => pm.expect(pm.response.json()).to.have.property('access_token'));"
          ]
        }
      }]
    },
    {
      "name": "POST /auth/logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/auth/logout",
        "body": { "mode": "raw", "raw": "" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ]
        }
      }]
    },
    {
      "name": "GET /api/users — sin token (debe retornar 401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ]
        }
      }]
    },
    {
      "name": "GET /api/users — con token ADMIN",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/api/users"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]
        }
      }]
    }
  ]
}
